<?xml version="1.0" encoding="utf-8"?>
<!-- Splash animé CargoLink (Android 12+) : le colis indigo entre en glissant,
     la flèche de livraison apparaît, deux anneaux pulsent autour du logo.
     Conçu dans le cercle de sûreté ⌀192 (masque système) : tout rayon
     (contenu × échelle max 1.14) reste <= 96. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
  <aapt:attr name="android:drawable">
    <vector
        android:name="cargolink_splash"
        android:width="288dp"
        android:height="288dp"
        android:viewportWidth="288"
        android:viewportHeight="288">
      <!-- Anneau externe (indigo) : r=74 → 84 à l'échelle max -->
      <group
          android:name="ring_outer_g"
          android:pivotX="144"
          android:pivotY="144"
          android:alpha="0">
        <path
            android:name="ring_outer"
            android:strokeColor="#6366F1"
            android:strokeWidth="5"
            android:fillColor="#00000000"
            android:pathData="M144,70 a74,74 0 1,0 0.01,0 z" />
      </group>
      <!-- Anneau interne (violet) : r=60 → 68 à l'échelle max -->
      <group
          android:name="ring_inner_g"
          android:pivotX="144"
          android:pivotY="144"
          android:alpha="0">
        <path
            android:name="ring_inner"
            android:strokeColor="#8B5CF6"
            android:strokeWidth="4"
            android:fillColor="#00000000"
            android:pathData="M144,84 a60,60 0 1,0 0.01,0 z" />
      </group>
      <!-- Colis (indigo) + bandeau : coins à ~72 du centre -->
      <group
          android:name="box_g"
          android:pivotX="144"
          android:pivotY="150"
          android:translateY="14"
          android:alpha="0">
        <path
            android:name="box"
            android:fillColor="#6366F1"
            android:pathData="M100,110 h88 a12,12 0 0 1 12,12 v56 a12,12 0 0 1 -12,12 h-88 a12,12 0 0 1 -12,-12 v-56 a12,12 0 0 1 12,-12 z M88,130 h112 v10 h-112 z" />
        <!-- Flèche blanche vers le bas (livraison) -->
        <path
            android:name="arrow"
            android:fillColor="#FFFFFF"
            android:pathData="M138,146 h12 v18 h9 l-15,15 l-15,-15 h9 z" />
      </group>
    </vector>
  </aapt:attr>

  <!-- Le colis glisse vers le haut puis reste en place -->
  <target android:name="box_g">
    <objectAnimator
        android:propertyName="translateY"
        android:startOffset="120"
        android:duration="480"
        android:valueFrom="14"
        android:valueTo="0"
        android:valueType="floatType"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:repeatCount="0" />
    <objectAnimator
        android:propertyName="alpha"
        android:startOffset="120"
        android:duration="360"
        android:valueFrom="0"
        android:valueTo="1"
        android:valueType="floatType"
        android:repeatCount="0" />
  </target>

  <!-- Anneaux pulsants en boucle -->
  <target android:name="ring_outer_g">
    <objectAnimator
        android:propertyName="scale"
        android:duration="1100"
        android:valueFrom="0.72"
        android:valueTo="1.14"
        android:valueType="floatType"
        android:repeatCount="infinite"
        android:repeatMode="restart" />
    <objectAnimator
        android:propertyName="alpha"
        android:duration="1100"
        android:valueFrom="0.9"
        android:valueTo="0"
        android:valueType="floatType"
        android:repeatCount="infinite"
        android:repeatMode="restart" />
  </target>
  <target android:name="ring_inner_g">
    <objectAnimator
        android:propertyName="scale"
        android:startOffset="280"
        android:duration="1100"
        android:valueFrom="0.72"
        android:valueTo="1.14"
        android:valueType="floatType"
        android:repeatCount="infinite"
        android:repeatMode="restart" />
    <objectAnimator
        android:propertyName="alpha"
        android:startOffset="280"
        android:duration="1100"
        android:valueFrom="0.9"
        android:valueTo="0"
        android:valueType="floatType"
        android:repeatCount="infinite"
        android:repeatMode="restart" />
  </target>
</animated-vector>
